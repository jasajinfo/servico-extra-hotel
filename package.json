{
  "name": "api-servicos-extras-hotel",
  "version": "1.0.0",
  "description": "Microsserviço Fastify para serviços extras, disponibilidades e agendamentos de hotel",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
